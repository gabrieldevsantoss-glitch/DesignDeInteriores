# ------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# ------------------------------------------------------------------

# Porta do servidor Express
PORT=3000

# Conexao Postgres usada pelo Sequelize.
# Supabase > Project Settings > Database > Connect > "Session pooler"
# Ex.: postgresql://postgres.<ref>:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase Auth / Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase > Project Settings > API Keys > "service_role" (secreta! nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=
