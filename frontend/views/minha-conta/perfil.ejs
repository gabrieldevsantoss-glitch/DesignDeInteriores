<%- include('../partials/site-topo') %>
<main class="pagina">
  <div class="container" style="max-width: 720px">
    <div class="pagina-titulo">
      <h1>Meus dados</h1>
      <a href="/minha-conta">&larr; Minha conta</a>
    </div>
    <%- include('../partials/flash') %>

    <form class="cartao" action="/minha-conta/perfil" method="post">
      <div class="campo"><label>E-mail (login)</label><input value="<%= cliente.email %>" disabled></div>
      <div class="campo"><label for="nome">Nome *</label><input id="nome" name="nome" value="<%= cliente.nome %>" required></div>
      <div class="linha-campos">
        <div class="campo"><label for="telefone">Telefone</label><input id="telefone" name="telefone" value="<%= cliente.telefone || '' %>"></div>
        <div class="campo"><label for="cpf_cnpj">CPF / CNPJ</label><input id="cpf_cnpj" name="cpf_cnpj" value="<%= cliente.cpf_cnpj || '' %>"></div>
      </div>
      <div class="campo"><label for="endereco">Endereço</label><input id="endereco" name="endereco" value="<%= cliente.endereco || '' %>"></div>
      <div class="linha-campos">
        <div class="campo"><label for="cidade">Cidade</label><input id="cidade" name="cidade" value="<%= cliente.cidade || '' %>"></div>
        <div class="campo"><label for="estado">UF</label><input id="estado" name="estado" maxlength="2" value="<%= cliente.estado || '' %>"></div>
        <div class="campo"><label for="cep">CEP</label><input id="cep" name="cep" value="<%= cliente.cep || '' %>"></div>
      </div>
      <button class="btn" type="submit">Salvar</button>
    </form>
  </div>
</main>
<%- include('../partials/site-fim') %>
