<%- include('../../partials/painel-topo') %>
<% const editando = Boolean(produto.id); %>

<div class="pagina-titulo">
  <h1><%= titulo %></h1>
  <a href="/painel/produtos">&larr; Produtos</a>
</div>

<form class="cartao" action="<%= editando ? '/painel/produtos/' + produto.id : '/painel/produtos' %>" method="post" style="max-width: 820px">
  <div class="linha-campos">
    <div class="campo"><label for="nome">Nome *</label><input id="nome" name="nome" value="<%= produto.nome || '' %>" required></div>
    <div class="campo">
      <label for="tipo">Tipo *</label>
      <select id="tipo" name="tipo">
        <% Object.entries(TIPOS_PRODUTO).forEach(([valor, rotulo]) => { %>
          <option value="<%= valor %>" <%= produto.tipo === valor ? 'selected' : '' %>><%= rotulo %></option>
        <% }) %>
      </select>
    </div>
    <div class="campo"><label for="categoria">Categoria</label><input id="categoria" name="categoria" value="<%= produto.categoria || '' %>" placeholder="Ex.: Cozinha, Dormitório"></div>
  </div>

  <div class="campo"><label for="descricao">Descrição</label><textarea id="descricao" name="descricao"><%= produto.descricao || '' %></textarea></div>

  <div class="linha-campos">
    <div class="campo"><label for="preco">Preço (R$) *</label><input id="preco" name="preco" type="number" min="0" step="0.01" value="<%= produto.preco || 0 %>" required></div>
    <div class="campo"><label for="estoque_minimo">Estoque mínimo</label><input id="estoque_minimo" name="estoque_minimo" type="number" min="0" value="<%= produto.estoque_minimo || 0 %>"></div>
    <% if (!editando) { %>
      <div class="campo"><label for="estoque_inicial">Estoque inicial</label><input id="estoque_inicial" name="estoque_inicial" type="number" min="0" value="0"></div>
    <% } else { %>
      <div class="campo"><label>Estoque atual</label><input value="<%= produto.quantidade_estoque %>" disabled><p class="ajuda">Altere pela tela de Estoque.</p></div>
    <% } %>
  </div>

  <div class="campo campo-check">
    <input id="ativo" name="ativo" type="checkbox" <%= produto.ativo ? 'checked' : '' %>>
    <label for="ativo">Ativo (aparece no site e nos pedidos)</label>
  </div>

  <button class="btn" type="submit">Salvar</button>
</form>

<%- include('../../partials/painel-fim') %>
