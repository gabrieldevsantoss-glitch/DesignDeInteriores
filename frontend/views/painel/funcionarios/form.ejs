<%- include('../../partials/painel-topo') %>
<% const editando = Boolean(funcionario.id); %>

<div class="pagina-titulo">
  <h1><%= titulo %></h1>
  <a href="/painel/funcionarios">&larr; Funcionários</a>
</div>

<form class="cartao" action="<%= editando ? '/painel/funcionarios/' + funcionario.id : '/painel/funcionarios' %>" method="post" style="max-width: 640px">
  <div class="campo"><label for="nome">Nome *</label><input id="nome" name="nome" value="<%= funcionario.nome || '' %>" required></div>
  <div class="linha-campos">
    <div class="campo">
      <label for="email">E-mail (login) *</label>
      <input id="email" name="email" type="email" value="<%= funcionario.email || '' %>" <%= editando ? 'disabled' : 'required' %>>
    </div>
    <div class="campo"><label for="telefone">Telefone</label><input id="telefone" name="telefone" value="<%= funcionario.telefone || '' %>"></div>
  </div>

  <div class="linha-campos">
    <div class="campo">
      <label for="perfil">Perfil de acesso *</label>
      <select id="perfil" name="perfil">
        <% Object.entries(PERFIS).forEach(([valor, rotulo]) => { %>
          <option value="<%= valor %>" <%= funcionario.perfil === valor ? 'selected' : '' %>><%= rotulo %></option>
        <% }) %>
      </select>
    </div>
    <div class="campo">
      <label for="senha"><%= editando ? 'Nova senha (opcional)' : 'Senha inicial *' %></label>
      <input id="senha" name="senha" type="password" minlength="6" <%= editando ? '' : 'required' %>>
    </div>
  </div>

  <% if (editando) { %>
    <div class="campo campo-check">
      <input id="ativo" name="ativo" type="checkbox" <%= funcionario.ativo ? 'checked' : '' %>>
      <label for="ativo">Ativo (pode acessar o painel)</label>
    </div>
  <% } %>

  <button class="btn" type="submit">Salvar</button>
</form>

<%- include('../../partials/painel-fim') %>
